<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Engine-bundled packages can have different archive hashes from nuget.org despite identical assemblies. -->
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == '' And '$(NUGET_PACKAGES)' == ''">$(MSBuildProjectDirectory)/.godot/mono/nuget</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'ExportRelease'">
    <Compile Include="../../tests/SpaceTangent.Application.Tests/LegacyWireFixture.cs" Link="tests/LegacyWireFixture.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SpaceTangent.Application/SpaceTangent.Application.csproj" />
    <ProjectReference Include="../../deps/space-tangent-core/src/SpaceTangent.Core/SpaceTangent.Core.csproj" />
    <ProjectReference Include="../../deps/space-tangent-core/src/SpaceTangent.Contracts/SpaceTangent.Contracts.csproj" />
  </ItemGroup>
</Project>
